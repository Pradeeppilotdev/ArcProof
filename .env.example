# Arc Testnet Configuration
# Get RPC URL and chain ID from: https://docs.arc.io/arc/references/connect-to-arc
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Wallet private key (testnet only — never use a mainnet key)
PRIVATE_KEY=your_testnet_wallet_private_key

# Agent address for proof generation
AGENT_ADDRESS=0x0000000000000000000000000000000000000001
